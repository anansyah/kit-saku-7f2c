<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/akar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/latar">

    <LinearLayout
        android:id="@+id/kepala_reader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/latar_lembut"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tombol_kembali"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="@string/kembali"
            android:textColor="@color/aksen"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/label_sumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/teks2"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/muat"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminateTint="@color/aksen"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/kaki_reader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/latar_lembut"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">

        <TextView
            android:id="@+id/tombol_simpan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="6dp"
            android:text="@string/simpan"
            android:textColor="@color/aksen"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tombol_ukuran"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="6dp"
            android:text="@string/ukuran"
            android:textColor="@color/teks2"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tombol_bagikan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="6dp"
            android:text="@string/berbagi"
            android:textColor="@color/teks2"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tombol_browser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="6dp"
            android:text="@string/browser"
            android:textColor="@color/teks2"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
