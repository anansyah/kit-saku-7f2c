<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/latar">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/merah"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tombol_kembali"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/panah_kembali"
            android:textColor="@color/kepala_teks"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/label_sumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingLeft="4dp"
            android:text="@string/sumber"
            android:textColor="@color/kepala_sub"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tombol_ukuran"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/ukuran_huruf"
            android:textColor="@color/kepala_teks"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tombol_simpan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/simpan"
            android:textColor="@color/kepala_teks"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tombol_bagikan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/berbagi"
            android:textColor="@color/kepala_teks"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tombol_browser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/buka_browser"
            android:textColor="@color/kepala_teks"
            android:textSize="13sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/muat"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:visibility="gone" />

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
