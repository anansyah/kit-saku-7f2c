<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/latar">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/merah"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/kepala_teks"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tombol_tersimpan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/tersimpan"
                android:textColor="@color/kepala_sub"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tombol_segar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/segar"
                android:textColor="@color/kepala_teks"
                android:textSize="16sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/cari"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:hint="@string/cari_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:padding="10dp"
            android:textColor="#1A1A1A"
            android:textColorHint="#9E9E9E"
            android:textSize="14sp" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/latar_lembut"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/baris_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:text="@string/memuat"
        android:textColor="@color/teks_pudar"
        android:textSize="15sp" />

    <ListView
        android:id="@+id/daftar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp" />

    <TextView
        android:id="@+id/lebih"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/latar_lembut"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/muat_lagi"
        android:textColor="@color/merah"
        android:textSize="15sp"
        android:visibility="gone" />
</LinearLayout>
